# ── Django ─────────────────────────────────────────────────────────────
DJANGO_SECRET_KEY=dev-insecure-change-me
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# Comma-separated origins allowed to embed the widget / call the chat API
WIDGET_ALLOWED_ORIGINS=https://www.nordlandvvs.se,http://localhost:8000

# ── Database (Postgres; matches docker-compose) ────────────────────────
POSTGRES_DB=nordland
POSTGRES_USER=nordland
POSTGRES_PASSWORD=nordland
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# ── Gemini ─────────────────────────────────────────────────────────────
# PRODUCTION: Vertex AI (EU data residency for Swedish customers / GDPR).
# Requires either ADC (`gcloud auth application-default login`) or a service
# account JSON pointed to by GOOGLE_APPLICATION_CREDENTIALS.
GEMINI_USE_VERTEX=True
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=europe-north1
GOOGLE_APPLICATION_CREDENTIALS=

# DEV FALLBACK ONLY: consumer AI Studio key (no EU residency guarantee).
GEMINI_API_KEY=

# ── Lead routing ───────────────────────────────────────────────────────
LEAD_EMAIL_TO=
LEAD_EMAIL_FROM=bot@nordlandvvs.se
# Disabled sinks until the client provides these (see plan §15):
LEAD_WEBHOOK_URL=
LEAD_WEBHOOK_ENABLED=0
WORDPRESS_OFFERT_URL=
WORDPRESS_OFFERT_ENABLED=0

# ── Security (V2 §S5/S6/S7) ────────────────────────────────────────────
# When DEBUG=0 the app FAILS CLOSED unless: SECRET_KEY is non-default AND the
# Vertex location is europe-* (GDPR) OR ALLOW_NON_EU_RESIDENCY=1 (temporary).
ALLOW_NON_EU_RESIDENCY=0
HTTPS_ENABLED=0                 # set 1 in prod behind real TLS (enables HSTS + secure cookies)
CSRF_TRUSTED_ORIGINS=          # e.g. https://bot.nordlandvvs.se
PHONE_HASH_PEPPER=dev-pepper-change-me   # MUST differ from SECRET_KEY (returning-customer hashing)
RATE_LIMIT_SESSION=20          # new sessions / IP / window
RATE_LIMIT_MESSAGE=40          # messages / session / window
RATE_LIMIT_WINDOW=300
MAX_TOTAL_TURNS=25
MAX_IMAGES_PER_CONVERSATION=8
